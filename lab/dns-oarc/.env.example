# Copy to .env (gitignored) and adjust. Every script in this directory reads it.

# lab:  Routinator trusts only the Krill testbed TA in this lab, which holds
#       exactly two objects: ROA 1.1.1.0/24-24 => AS13335 and
#       ASPA AS53072 => {AS16735, AS23106, AS270735}. Works offline / behind
#       TLS interception. Use this on the laptop.
# live: Routinator uses the five bundled RIR TALs (real RPKI, needs outbound
#       HTTPS and rsync). Nothing trusts Krill. Use this on a server with
#       full internet access.
RPKI_MODE=lab

# Routinator's repository cache. Persistent across deploy/destroy so that
# restarts are warm (matters in live mode: a cold sync takes minutes).
# Relative paths are relative to this directory. It must be on a Linux
# filesystem: on WSL with the checkout under /mnt/c, Routinator's rsync
# cannot set file times there, so use e.g. $HOME/.cache/dnsoarc/routinator.
ROUTINATOR_CACHE_DIR=./runtime/routinator/repository

# Grafana on the host. The only host port the lab publishes.
GRAFANA_PORT=3047
# Grafana's admin password (user admin). deploy.sh refuses the placeholder.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
